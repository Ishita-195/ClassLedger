@using System.Linq
@model StudentResult.Models.ReportsDashboardVM
@{
    ViewData["Title"] = "Reports & Analytics";
}

<h4 class="mb-4 page-title">📈 Reports &amp; Analytics</h4>

@if (!Model.AttendanceDistribution.Any() && !Model.CoursePassFail.Any()
     && !Model.GradeDistribution.Any() && !Model.AttendanceVsResult.Any())
{
    <div class="alert alert-info">No data available yet. Add students, marks and attendance to see analytics.</div>
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><h6 class="mb-0">Attendance % Distribution (students)</h6></div>
            <div class="card-body"><canvas id="attendanceChart" height="220"></canvas></div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><h6 class="mb-0">Pass / Fail per Course</h6></div>
            <div class="card-body"><canvas id="passFailChart" height="220"></canvas></div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><h6 class="mb-0">Grade / Marks Distribution</h6></div>
            <div class="card-body"><canvas id="gradeChart" height="220"></canvas></div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><h6 class="mb-0">Avg Attendance vs Avg Result</h6></div>
            <div class="card-body"><canvas id="scatterChart" height="220"></canvas></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/chartjs/chart.umd.min.js"></script>
    <script>
        // Data serialized from the per-chart ViewModels (aggregated in SQL).
        // Json.Serialize returns script-safe, HTML-encoded JSON emitted verbatim.
        var attLabels   = @Json.Serialize(Model.AttendanceDistribution.Select(x => x.Bucket));
        var attData     = @Json.Serialize(Model.AttendanceDistribution.Select(x => x.StudentCount));

        var courseLabels = @Json.Serialize(Model.CoursePassFail.Select(x => x.CourseName));
        var passData     = @Json.Serialize(Model.CoursePassFail.Select(x => x.PassCount));
        var failData     = @Json.Serialize(Model.CoursePassFail.Select(x => x.FailCount));

        var gradeLabels = @Json.Serialize(Model.GradeDistribution.Select(x => x.Grade));
        var gradeData   = @Json.Serialize(Model.GradeDistribution.Select(x => x.Count));

        var scatterData = @Json.Serialize(Model.AttendanceVsResult
                              .Select(x => new { x = x.AvgAttendance, y = x.AvgResult, label = x.StudentName }));

        var navy = '#5b6e74', teal = '#819fa7', green = '#4c8577', red = '#b0525f', amber = '#c99a3f';

        // 1. Attendance % distribution
        new Chart(document.getElementById('attendanceChart'), {
            type: 'bar',
            data: {
                labels: attLabels,
                datasets: [{ label: 'Students', data: attData, backgroundColor: teal }]
            },
            options: {
                scales: { y: { beginAtZero: true, ticks: { precision: 0 }, title: { display: true, text: 'Students' } },
                          x: { title: { display: true, text: 'Attendance band' } } },
                plugins: { legend: { display: false } }
            }
        });

        // 2. Pass / fail per course (grouped bars)
        new Chart(document.getElementById('passFailChart'), {
            type: 'bar',
            data: {
                labels: courseLabels,
                datasets: [
                    { label: 'Pass', data: passData, backgroundColor: green },
                    { label: 'Fail', data: failData, backgroundColor: red }
                ]
            },
            options: {
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });

        // 3. Grade / marks distribution histogram
        new Chart(document.getElementById('gradeChart'), {
            type: 'bar',
            data: {
                labels: gradeLabels,
                datasets: [{ label: 'Marks entries', data: gradeData, backgroundColor: navy }]
            },
            options: {
                scales: { y: { beginAtZero: true, ticks: { precision: 0 }, title: { display: true, text: 'Count' } },
                          x: { title: { display: true, text: 'Grade band' } } },
                plugins: { legend: { display: false } }
            }
        });

        // 4. Avg attendance vs avg result (scatter → correlation)
        new Chart(document.getElementById('scatterChart'), {
            type: 'scatter',
            data: {
                datasets: [{ label: 'Students', data: scatterData, backgroundColor: amber, pointRadius: 6 }]
            },
            options: {
                scales: {
                    x: { title: { display: true, text: 'Avg attendance %' }, min: 0, max: 100 },
                    y: { title: { display: true, text: 'Avg result %' }, min: 0, max: 100 }
                },
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function (ctx) {
                                var p = ctx.raw;
                                return p.label + ' (att ' + p.x + '%, res ' + p.y + '%)';
                            }
                        }
                    },
                    legend: { display: false }
                }
            }
        });
    </script>
}

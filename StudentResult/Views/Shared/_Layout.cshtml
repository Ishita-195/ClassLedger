<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ClassLedger</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📒</text></svg>" />
    <link rel="stylesheet" href="~/css/bootstrap_min_css_5.2.3/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    @if (Context.Session.GetString("UserID") != null)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        Func<string, string, string> navActive = (ctrl, act) =>
            (currentController == ctrl && currentAction == act) ? "active" : "";
        var role = Context.Session.GetString("UserRole");

        <!-- Mobile top bar -->
        <div class="mobile-topbar d-md-none d-flex align-items-center justify-content-between">
            <button class="btn btn-sm" id="sidebarToggle" aria-label="Menu">☰</button>
            <span class="brand">📒 ClassLedger</span>
            <span style="width:36px;"></span>
        </div>

        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <div class="d-flex">
            <!-- Sidebar -->
            <div class="sidebar" id="sidebarMenu">
                <div class="text-center mb-3">
                    <span class="sidebar-brand">📒 ClassLedger</span>
                    <div class="sidebar-brand-sub">Attendance &amp; Results</div>
                </div>
                <hr class="sidebar-divider" style="margin:0 10px 10px;">

                <div class="sidebar-heading">Main</div>
                <a class="@navActive("Home", "Dashboard")" asp-action="Dashboard" asp-controller="Home">🏠 Dashboard</a>

                @if (role == "Admin" || role == "Teacher")
                {
                    <div class="sidebar-heading">Manage</div>
                    <a class="@navActive("Home", "Students")"   asp-action="Students"   asp-controller="Home">👨‍🎓 Students</a>
                    <a class="@navActive("Home", "Marks")"      asp-action="Marks"      asp-controller="Home">📝 Marks</a>
                    <a class="@navActive("Home", "Attendance")" asp-action="Attendance" asp-controller="Home">📅 Attendance</a>
                }

                @if (role == "Admin")
                {
                    <a class="@navActive("Home", "Classes")" asp-action="Classes" asp-controller="Home">🏫 Classes & Subjects</a>
                    <div class="sidebar-heading">Analytics</div>
                    <a class="@navActive("Reports", "Index")" asp-action="Index" asp-controller="Reports">📈 Reports</a>
                }

                @if (role == "Student")
                {
                    <div class="sidebar-heading">My Portal</div>
                    <a class="@navActive("Home", "ReportCard")" asp-action="ReportCard" asp-controller="Home">📊 My Report Card</a>
                    <a class="@navActive("Home", "Attendance")" asp-action="Attendance" asp-controller="Home">📅 My Attendance</a>
                }

                <hr class="sidebar-divider" style="margin:10px;">
                <a class="sidebar-logout" asp-action="Logout" asp-controller="Home">🚪 Logout (@Context.Session.GetString("UserName"))</a>
            </div>

            <!-- Main Content -->
            <div class="flex-grow-1 main-content">
                @RenderBody()
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/js/jquery-3.6.1.min.js"></script>
    <script src="~/js/Bootstrap_min_js_5.2.3/bootstrap.min.js"></script>
    <script>
        (function () {
            var toggle = document.getElementById('sidebarToggle');
            var menu = document.getElementById('sidebarMenu');
            var backdrop = document.getElementById('sidebarBackdrop');
            if (!toggle || !menu) return;
            function open() { menu.classList.add('open'); backdrop.classList.add('show'); }
            function close() { menu.classList.remove('open'); backdrop.classList.remove('show'); }
            toggle.addEventListener('click', function () {
                menu.classList.contains('open') ? close() : open();
            });
            backdrop.addEventListener('click', close);
            // Close the drawer after tapping a link on mobile.
            menu.querySelectorAll('a').forEach(function (a) {
                a.addEventListener('click', close);
            });
        })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>

@model StudentResult.Models.StudentResultVM
@{
    ViewData["Title"] = "Marks";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0" style="color:#1a3c5e;">📝 Marks Entry</h4>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addMarksModal">+ Add Marks</button>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Student ID</th>
                    <th>Subject ID</th>
                    <th>Exam Type</th>
                    <th>Marks Scored</th>
                    <th>Total Marks</th>
                    <th>Percentage</th>
                    <th>Exam Date</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.AllMarks)
                {
                    var pct = m.Totalmarks > 0 ? Math.Round((decimal)(m.Marksscored / m.Totalmarks * 100), 1) : 0;
                    var grade = pct >= 90 ? "A+" : pct >= 75 ? "A" : pct >= 60 ? "B" : pct >= 45 ? "C" : "F";
                    var badgeColor = pct >= 75 ? "success" : pct >= 45 ? "warning" : "danger";
                    <tr>
                        <td>@m.Studentid</td>
                        <td>@m.Subjectid</td>
                        <td><span class="badge bg-info text-dark">@m.Examtype</span></td>
                        <td>@m.Marksscored</td>
                        <td>@m.Totalmarks</td>
                        <td><span class="badge bg-@badgeColor">@pct% (@grade)</span></td>
                        <td>@m.Examdate?.ToString("dd MMM yyyy")</td>
                        <td>
                            <a asp-action="DeleteMark" asp-route-id="@m.Markid"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Delete this mark?')">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Marks Modal -->
<div class="modal fade" id="addMarksModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#1a3c5e; color:white;">
                <h5 class="modal-title">Add Marks</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddMarks" method="get">
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">Student</label>
                        <select name="SrMarksObj.Studentid" class="form-select">
                            @foreach (var s in Model.AllStudents)
                            {
                                <option value="@s.Studentid">@s.Rollno - @s.Studentname</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Subject</label>
                        <select name="SrMarksObj.Subjectid" class="form-select">
                            @foreach (var sub in Model.AllSubjects)
                            {
                                <option value="@sub.Subjectid">@sub.Subjectname</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Exam Type</label>
                        <select name="SrMarksObj.Examtype" class="form-select">
                            <option>Unit Test</option>
                            <option>Mid Term</option>
                            <option>Final</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Marks Scored</label>
                        <input name="SrMarksObj.Marksscored" type="number" class="form-control" min="0" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Total Marks</label>
                        <input name="SrMarksObj.Totalmarks" type="number" class="form-control" value="100" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Marks</button>
                </div>
            </form>
        </div>
    </div>
</div>

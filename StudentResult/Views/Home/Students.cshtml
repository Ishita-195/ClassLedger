@model StudentResult.Models.StudentResultVM
@{
    ViewData["Title"] = "Students";
    var classLabel = (Model.AllClasses ?? new List<StudentResult.Models.SrClasses>())
        .ToDictionary(c => c.Classid, c => $"{c.Classname} - {c.Section}");
    string ClassName(int? id) => id.HasValue && classLabel.TryGetValue(id.Value, out var n) ? n : "—";
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="page-title mb-0">Students</h4>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addStudentModal">+ Add Student</button>
</div>

@if (ViewBag.FilterClassName != null)
{
    <div class="mb-3">
        <span class="badge" style="background:var(--accent); color:#fff;">Class: @ViewBag.FilterClassName</span>
        <a asp-action="Students" class="ms-2" style="font-size:13px;">Clear filter — show all</a>
    </div>
}
else
{
    <div class="mb-3"></div>
}

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Roll No</th>
                        <th>Name</th>
                        <th>Class</th>
                        <th>Gender</th>
                        <th>Parent</th>
                        <th>Contact</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.AllStudents == null || !Model.AllStudents.Any())
                    {
                        <tr><td colspan="7" class="table-empty">No students yet — add one to get started.</td></tr>
                    }
                    else
                    {
                        @foreach (var s in Model.AllStudents)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@s.Rollno</span></td>
                                <td>@s.Studentname</td>
                                <td>@ClassName(s.Classid)</td>
                                <td>@s.Gender</td>
                                <td>@s.Parentname</td>
                                <td>@s.Contactno</td>
                                <td>
                                    <form asp-action="DeleteStudent" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this student?')">
                                        <input type="hidden" name="id" value="@s.Studentid" />
                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Student Modal -->
<div class="modal fade" id="addStudentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header modal-header-navy">
                <h5 class="modal-title">Add New Student</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddStudent" method="post">
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">Full Name</label>
                        <input name="SrStudentsObj.Studentname" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Roll Number</label>
                        <input name="SrStudentsObj.Rollno" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Class</label>
                        <select name="SrStudentsObj.Classid" class="form-select">
                            @foreach (var c in Model.AllClasses)
                            {
                                <option value="@c.Classid">@c.Classname - @c.Section</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Gender</label>
                        <select name="SrStudentsObj.Gender" class="form-select">
                            <option>Male</option>
                            <option>Female</option>
                            <option>Other</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Parent Name</label>
                        <input name="SrStudentsObj.Parentname" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Contact No</label>
                        <input name="SrStudentsObj.Contactno" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Student</button>
                </div>
            </form>
        </div>
    </div>
</div>

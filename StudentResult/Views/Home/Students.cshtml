@model StudentResult.Models.StudentResultVM
@{
    ViewData["Title"] = "Students";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0" style="color:#1a3c5e;">👨‍🎓 Students</h4>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addStudentModal">+ Add Student</button>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Roll No</th>
                    <th>Name</th>
                    <th>Class</th>
                    <th>Gender</th>
                    <th>Parent</th>
                    <th>Contact</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.AllStudents)
                {
                    <tr>
                        <td><span class="badge bg-secondary">@s.Rollno</span></td>
                        <td>@s.Studentname</td>
                        <td>@s.Classid</td>
                        <td>@s.Gender</td>
                        <td>@s.Parentname</td>
                        <td>@s.Contactno</td>
                        <td>
                            <a asp-action="DeleteStudent" asp-route-id="@s.Studentid"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Delete this student?')">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Student Modal -->
<div class="modal fade" id="addStudentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#1a3c5e; color:white;">
                <h5 class="modal-title">Add New Student</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddStudent" method="get">
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">Full Name</label>
                        <input name="SrStudentsObj.Studentname" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Roll Number</label>
                        <input name="SrStudentsObj.Rollno" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Class</label>
                        <select name="SrStudentsObj.Classid" class="form-select">
                            @foreach (var c in Model.AllClasses)
                            {
                                <option value="@c.Classid">@c.Classname - @c.Section</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Gender</label>
                        <select name="SrStudentsObj.Gender" class="form-select">
                            <option>Male</option>
                            <option>Female</option>
                            <option>Other</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Parent Name</label>
                        <input name="SrStudentsObj.Parentname" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Contact No</label>
                        <input name="SrStudentsObj.Contactno" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Student</button>
                </div>
            </form>
        </div>
    </div>
</div>

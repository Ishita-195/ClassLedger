@model StudentResult.Models.StudentResultVM
@{
    ViewData["Title"] = "Classes & Subjects";
    var studentsPerClass = (Model.AllStudents ?? new List<StudentResult.Models.SrStudents>())
        .Where(s => s.Classid != null)
        .GroupBy(s => s.Classid.Value)
        .ToDictionary(g => g.Key, g => g.Count());
    int CountFor(int classId) => studentsPerClass.TryGetValue(classId, out var n) ? n : 0;
    int subjectCount = (Model.AllSubjects ?? new List<StudentResult.Models.SrSubjects>()).Count;

    string ClassBadge(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var digits = new string(name.TakeWhile(char.IsDigit).ToArray());
        return string.IsNullOrEmpty(digits) ? name.Substring(0, 1).ToUpper() : digits;
    }
}

<h4 class="page-title mb-4">Classes &amp; Subjects</h4>

<!-- ── Classes ───────────────────────────────── -->
<div class="section-label">
    <h5>Classes <span class="class-count-badge">@Model.AllClasses.Count</span></h5>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addClassModal">+ Add Class</button>
</div>

@if (!Model.AllClasses.Any())
{
    <div class="alert alert-info">No classes yet.</div>
}
else
{
    <div class="student-grid mb-4">
        @foreach (var c in Model.AllClasses)
        {
            <a class="student-card" asp-action="Students" asp-controller="Home" asp-route-classId="@c.Classid">
                <div class="avatar">@ClassBadge(c.Classname)</div>
                <div>
                    <div class="student-name">@c.Classname - @c.Section</div>
                    <div class="student-meta">@CountFor(c.Classid) student@(CountFor(c.Classid) == 1 ? "" : "s") · @subjectCount subjects</div>
                    <div class="student-meta" style="color:var(--navy); font-weight:600;">View students →</div>
                </div>
            </a>
        }
    </div>
}

<!-- ── Curriculum / Subjects ─────────────────── -->
<div class="section-label mt-4">
    <div>
        <h5>Curriculum <span class="class-count-badge">@subjectCount</span></h5>
        <div class="count-note">Subjects taught across all classes</div>
    </div>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addSubjectModal">+ Add Subject</button>
</div>

@if (!Model.AllSubjects.Any())
{
    <div class="alert alert-info">No subjects yet.</div>
}
else
{
    <div class="subject-chips">
        @foreach (var s in Model.AllSubjects)
        {
            <span class="subject-chip"><span class="dot"></span>@s.Subjectname</span>
        }
    </div>
}

<!-- Add Class Modal -->
<div class="modal fade" id="addClassModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header modal-header-navy">
                <h5 class="modal-title">Add Class</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddClass" method="post">
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">Class Name</label>
                        <input name="SrClassesObj.Classname" class="form-control" placeholder="e.g. 10th" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Section</label>
                        <input name="SrClassesObj.Section" class="form-control" placeholder="e.g. A" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Subject Modal -->
<div class="modal fade" id="addSubjectModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header modal-header-navy">
                <h5 class="modal-title">Add Subject</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddSubject" method="post">
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">Subject Name</label>
                        <input name="SrSubjectsObj.Subjectname" class="form-control" placeholder="e.g. Geography" required />
                    </div>
                    <div class="text-muted" style="font-size:12px;">Subjects apply to all classes (school curriculum).</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

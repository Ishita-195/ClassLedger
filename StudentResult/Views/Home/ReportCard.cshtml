@model StudentResult.Models.StudentResultVM
@{
    ViewData["Title"] = "My Report Card";
    var subjectLabel = (Model.AllSubjects ?? new List<StudentResult.Models.SrSubjects>())
        .ToDictionary(s => s.Subjectid, s => s.Subjectname);
    string SubjectName(int? id) => id.HasValue && subjectLabel.TryGetValue(id.Value, out var n) ? n : "—";
}

@if (Model.SrStudentsObj == null)
{
    <div class="alert alert-warning">No student record linked to your account. Please contact admin.</div>
}
else
{
    var student = Model.SrStudentsObj;
    var totalScored = Model.AllMarks.Sum(m => m.Marksscored ?? 0);
    var totalMax    = Model.AllMarks.Sum(m => m.Totalmarks  ?? 0);
    var overallPct  = totalMax > 0 ? Math.Round(totalScored / totalMax * 100, 1) : 0;
    var presentDays = Model.AllAttendance.Count(a => a.Status == "Present");
    var totalDays   = Model.AllAttendance.Count;
    var attendPct   = totalDays > 0 ? Math.Round((double)presentDays / totalDays * 100, 1) : 0;

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Report Card</span>
            <span style="font-size:13px;">Roll No: @student.Rollno</span>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="p-3 rounded" style="background:#eef3f8;">
                        <div class="text-muted" style="font-size:12px;">STUDENT NAME</div>
                        <div class="fw-bold">@student.Studentname</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 rounded" style="background:#eef3f8;">
                        <div class="text-muted" style="font-size:12px;">OVERALL PERCENTAGE</div>
                        <div class="fw-bold" style="color:#17516b; font-size:1.4rem;">@overallPct%</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 rounded" style="background:#eef3f8;">
                        <div class="text-muted" style="font-size:12px;">ATTENDANCE</div>
                        <div class="fw-bold" style="color: @(attendPct >= 75 ? "#16a34a" : "#e11d48"); font-size:1.4rem;">@attendPct%</div>
                    </div>
                </div>
            </div>

            <h6 class="fw-bold mb-2" style="color:#17516b;">Subject-wise Marks</h6>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Subject</th>
                        <th>Exam Type</th>
                        <th>Marks Scored</th>
                        <th>Total</th>
                        <th>Grade</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.AllMarks)
                    {
                        var pct = m.Totalmarks > 0 ? Math.Round((decimal)(m.Marksscored / m.Totalmarks * 100), 1) : 0;
                        var grade = pct >= 90 ? "A+" : pct >= 75 ? "A" : pct >= 60 ? "B" : pct >= 45 ? "C" : "F";
                        var color = pct >= 75 ? "success" : pct >= 45 ? "warning" : "danger";
                        <tr>
                            <td>@SubjectName(m.Subjectid)</td>
                            <td>@m.Examtype</td>
                            <td>@m.Marksscored</td>
                            <td>@m.Totalmarks</td>
                            <td><span class="badge bg-@color">@grade (@pct%)</span></td>
                        </tr>
                    }
                </tbody>
            </table>

            <h6 class="fw-bold mb-2 mt-4" style="color:#17516b;">Attendance Summary</h6>
            <div class="row">
                <div class="col-md-3">
                    <div class="p-3 rounded text-center" style="background:#dcfce7;">
                        <div style="font-size:1.5rem; font-weight:700; color:#16a34a;">@presentDays</div>
                        <div style="font-size:12px; color:#16a34a;">Days Present</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 rounded text-center" style="background:#ffe4e6;">
                        <div style="font-size:1.5rem; font-weight:700; color:#e11d48;">@(totalDays - presentDays)</div>
                        <div style="font-size:12px; color:#e11d48;">Days Absent</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 rounded text-center" style="background:#eef3f8;">
                        <div style="font-size:1.5rem; font-weight:700; color:#17516b;">@totalDays</div>
                        <div style="font-size:12px;">Total Days</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

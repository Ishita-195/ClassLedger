@model StudentResult.Models.StudentResultVM
@{
    ViewData["Title"] = "Dashboard";
}

<h4 class="mb-4 fw-bold" style="color:#1a3c5e;">📊 Dashboard</h4>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card" style="background:#1a3c5e;">
            <div style="font-size:2rem;">👨‍🎓</div>
            <div style="font-size:1.8rem; font-weight:700;">@Model.TotalStudents</div>
            <div>Total Students</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="background:#2e7d9e;">
            <div style="font-size:2rem;">🏫</div>
            <div style="font-size:1.8rem; font-weight:700;">@Model.TotalClasses</div>
            <div>Classes</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="background:#28a745;">
            <div style="font-size:2rem;">✅</div>
            <div style="font-size:1.8rem; font-weight:700;">@Model.TotalPresent</div>
            <div>Present Today</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card" style="background:#dc3545;">
            <div style="font-size:2rem;">❌</div>
            <div style="font-size:1.8rem; font-weight:700;">@Model.TotalAbsent</div>
            <div>Absent Today</div>
        </div>
    </div>
</div>

<!-- Recent Students Table -->
<div class="card">
    <div class="card-header">
        <h6 class="mb-0">Recent Students</h6>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Roll No</th>
                    <th>Name</th>
                    <th>Class ID</th>
                    <th>Gender</th>
                    <th>Contact</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.AllStudents.Take(5))
                {
                    <tr>
                        <td><span class="badge bg-secondary">@s.Rollno</span></td>
                        <td>@s.Studentname</td>
                        <td>@s.Classid</td>
                        <td>@s.Gender</td>
                        <td>@s.Contactno</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
